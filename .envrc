# Source this file to get docker and kubectl pointing to the Windows binaries
# (Docker Desktop's WSL integration is off in this setup, so we go through the
# Windows .exe directly. The path has a space, so we use a variable + quoted alias.)
export DOCKER_BIN="/mnt/c/Program Files/Docker/Docker/resources/bin"

# Add to PATH (quoted to handle the space)
export PATH="$DOCKER_BIN:$PATH"

# Aliases: wrap each binary so the space in the path is handled cleanly
docker() { "$DOCKER_BIN/docker.exe" "$@"; }
kubectl() { "$DOCKER_BIN/kubectl.exe" "$@"; }
